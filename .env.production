# 🗄️ NEO4J GRAPH DATABASE
NEO4J_URI=bolt://vps.archicamai.cm:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_STRONG_PRODUCTION_PASSWORD_2026!

# 🔥 FIREBASE PRODUCTION (PAS D'ÉMULATEUR)
FIREBASE_USE_EMULATOR=false
NEXT_PUBLIC_BYPASS_AUTH=false

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyProductionKeyRealValueHere
