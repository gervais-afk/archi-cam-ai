generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum PaymentProvider {
  STRIPE
  ORANGE_MONEY
  MTN_MOMO
  SYSTEM
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

// RISQUE 4 — Raisons d'échec du traitement de masque
enum FailureReason {
  DARK_CORRUPTED
  TOO_LIGHT
  BLURRY
  RULED_LINES
  COMPLEX_VALID
}

// RISQUE 5 — Étapes du pipeline de qualité
enum ProcessingStage {
  MASK_GENERATION
  RULED_LINES_REMOVAL
  RENDER_GENERATION
  METADATA_EXTRACTION
}


model User {
  id             String        @id @default(uuid())
  email          String?       @unique
  name           String?
  role           String        @default("CLIENT")
  creditsBalance Int           @default(10) @map("credits_balance")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  transactions   Transaction[]

  @@map("users")
}

model Transaction {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  amount    Int
  type      TransactionType
  provider  PaymentProvider   @default(SYSTEM)
  status    TransactionStatus @default(SUCCESS)
  feature   String?
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model RenderJob {
  id           String   @id @default(uuid())
  projectId    String?  @map("project_id")
  userId       String?  @map("user_id")
  mediaType    String   @map("media_type")
  prompt       String?
  style        String?
  status       String   @default("processing")
  mediaUrl     String?  @map("media_url")
  falRequestId String?  @map("fal_request_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("render_jobs")
}

// RISQUE 4 — Logging des échecs de traitement de masque OpenCV
model MaskProcessingFailure {
  id               String        @id @default(uuid())
  userId           String?       @map("user_id")
  projectId        String?       @map("project_id")
  failureReason    FailureReason @map("failure_reason")
  blackPixelRatio  Float         @map("black_pixel_ratio")
  edgeDensity      Float         @map("edge_density")
  blurScore        Float?        @map("blur_score")
  originalImagePath String?      @map("original_image_path")
  maskImagePath    String?       @map("mask_image_path")
  createdAt        DateTime      @default(now()) @map("created_at")

  @@map("mask_processing_failures")
}

// RISQUE 5 — Métriques de qualité par étape du pipeline
model QualityMetric {
  id            String          @id @default(uuid())
  projectId     String?         @map("project_id")
  userId        String?         @map("user_id")
  stage         ProcessingStage
  success       Boolean
  durationMs    Int             @map("duration_ms")
  confidence    Float?
  fallbackUsed  Boolean         @default(false) @map("fallback_used")
  metadata      Json?
  createdAt     DateTime        @default(now()) @map("created_at")

  @@map("quality_metrics")
}

// RISQUE 2 — Cache géométrique partagé entre modes de rendu
model GeometryCache {
  id          String   @id @default(uuid())
  imageHash   String   @unique @map("image_hash") // SHA-256 de l'image
  projectId   String?  @map("project_id")
  geometry    String   // JSON de la géométrie extraite (rooms, totalSurface, roomCount)
  extractedAt DateTime @default(now()) @map("extracted_at")

  @@index([imageHash])
  @@index([projectId])
  @@map("geometry_caches")
}

// CHAT MULTI-AGENTS — Historique et Widgets de discussion
model ChatMessage {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  sender      String   // Router, Metreur, User, Engineer, Legal, etc.
  text        String   @db.Text
  widgetType  String?  @map("widget_type") // DEVIS_TABLE, STRUCTURAL_SCHEMA, LEGAL_RADAR
  widgetData  Json?    @map("widget_data")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("chat_messages")
}

// OPTIMISATION 1 — Versioning des rendus
model RenderVersion {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  versionNumber Int      @map("version_number") // 1, 2, 3...
  imageUrl      String   @map("image_url")
  renderMode    String   @map("render_mode")
  stylePreset   String   @map("style_preset")
  geometryHash  String   @map("geometry_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([projectId, versionNumber])
  @@index([projectId, versionNumber])
  @@map("render_versions")
}

// OPTIMISATION 2 — Retours utilisateurs (Rating System)
model RenderFeedback {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  renderId    String?  @map("render_id")
  rating      Int      @map("rating")
  feedback    String?  @db.Text
  metadata    Json?    @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("render_feedbacks")
}

// B2B & INTEGRATIONS — Clés API et Webhooks
model Webhook {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  url       String
  event     String   // RENDER_COMPLETED, RENDER_FAILED
  secret    String   @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("webhooks")
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("api_keys")
}
