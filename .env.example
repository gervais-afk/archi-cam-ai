# -----------------------------------------------------------------------------
# ARCHI CAM AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# -----------------------------------------------------------------------------

# NEXT.JS SERVER CONFIG
PORT=3000
NODE_ENV=development

# GOOGLE AI STUDIO / GEMINI & IMAGEN 3.0
GEMINI_API_KEY=your_gemini_api_key_here

# SUPABASE STORAGE & DATABASE CONFIG
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# NEO4J GRAPH DATABASE (DOCKER)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# POSTGRESQL PGVECTOR DATABASE (DOCKER)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/archicam_db

# LOCAL DEVELOPMENT AUTH BYPASS
NEXT_PUBLIC_BYPASS_AUTH=true
