# ==============================================================================
# 🏛️ ARCHI CAM AI — VARIABLES D'ENVIRONNEMENT UNIFIÉES (.env.local.example)
# ==============================================================================

# ── MODE DE DÉVELOPPEMENT LOCAL ───────────────────────────────────────────────
LOCAL_RENDER_TEST_MODE=true
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── LM STUDIO (Local LLM / Gemma 4 12B Souverain) ────────────────────────────
ENABLE_LM_STUDIO_ANALYZER=true
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_MODEL=google/gemma-4-12b-qat
LOCAL_LLM_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=google/gemma-4-12b-qat

# ── BRIDGES CLOUD (VLM / Diffusion / OpenAI Fallback) ─────────────────────────
ENABLE_GEMINI_IMAGE_BRIDGE=true
GEMINI_API_KEY=AIzaSy...

ENABLE_REPLICATE_IMAGE_BRIDGE=true
REPLICATE_API_TOKEN=r8_...

ENABLE_OPENAI_IMAGE_BRIDGE=true
# Rotation des 3 clés OpenAI pour le Self-Healing
OPENAI_API_KEY=sk-proj-...
OPENAI_API_KEY_SECONDARY=sk-proj-...
OPENAI_API_KEY_TERTIARY=sk-proj-...

# ── NEO4J GRAPHRAG (Rules POS, BAEL 91, Mercuriale MINMAP 2025) ────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=archi-btp

# ── DUCKDB (Base OLAP Analytique Locale) ──────────────────────────────────────
DUCKDB_PATH=./data/archi_cam_ai.duckdb

# ── FASTMCP PYTHON WORKERS (MoteurCalculBTP :8000) ─────────────────────────────
FASTMCP_BASE_URL=http://localhost:8000
FASTMCP_URL=http://127.0.0.1:8000
ENABLE_FASTMCP_WORKERS=true

# ── ADK AGENTS PYTHON (Réseau d'Agents :8080) ──────────────────────────────────
ADK_BASE_URL=http://localhost:8080
ENABLE_ADK_AGENTS=true

# ── FIREBASE EMULATOR (Auth, Firestore, Storage, DataConnect) ────────────────
ENABLE_FIREBASE_EMULATOR=true
FIREBASE_EMULATOR_HOST=localhost:4000
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── POSTGRESQL / PGVECTOR (RAG Projets Historiques :5433) ──────────────────────
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fdcdb
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/fdcdb

# ── OKF (Open Knowledge Format) ───────────────────────────────────────────────
OKF_OUTPUT_DIR=./projects
OKF_VERSION=v0.2

# ── TOKENS EXTERNES (Cesium 3D, Elevation API) ────────────────────────────────
NEXT_PUBLIC_CESIUM_ION_TOKEN=eyJhbG...
NEXT_PUBLIC_ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup

# ── AUTH BYPASS EN DÉVELOPPEMENT LOCAL ──────────────────────────────────────
NEXT_PUBLIC_BYPASS_AUTH=false
