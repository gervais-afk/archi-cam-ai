    "@genkit-ai/google-genai": "^1.36.0",
    "@genkit-ai/mcp": "^1.36.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^5.18.0",
    "@radix-ui/react-progress": "^1.1.8",
    "@react-pdf/renderer": "^4.5.1",
    "@resvg/resvg-js": "^2.6.2",
    "@thatopen/components": "^3.4.6",
    "@types/pg": "^8.20.0",
    "@types/three": "^0.184.1",
    "cloudconvert": "^3.0.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.14.0",
    "framer-motion": "^12.38.0",
    "genkit": "^1.36.0",
    "lucide-react": "^0.400.0",
    "neo4j-driver": "^6.2.0",
    "next": "14.2.5",
    "pg": "^8.21.0",
    "react": "^18",
    "react-dom": "^18",
    "react-dropzone": "^14.2.3",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.3.0",
    "three": "^0.184.0",
    "typescript": "^5"
  },
  "devDependencies": {
