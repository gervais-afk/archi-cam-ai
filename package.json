{
  "name": "archi-cameroun-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:assets": "python scripts/check_assets.py",
    "check:python": "python scripts/validate_python_scripts.py",
    "test:local-render": "node scripts/validate-local-pipeline.js",
    "test:integration": "node scripts/integration-tests/run-all-tests.js",
    "test:render-only": "node scripts/integration-tests/run-all-tests.js --only=4",
    "test:bim-only": "node scripts/integration-tests/run-all-tests.js --only=5",
    "test:auth-only": "node scripts/integration-tests/run-all-tests.js --only=2,3",
    "test:billing-only": "node scripts/integration-tests/run-all-tests.js --only=11",
    "fixtures:generate": "python scripts/generate_test_fixtures.py",
    "validate:local": "npm run typecheck && python scripts/check_assets.py && python scripts/validate_python_scripts.py",
    "validate:full": "npm run typecheck && python scripts/generate_test_fixtures.py && npm run test:integration"
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
